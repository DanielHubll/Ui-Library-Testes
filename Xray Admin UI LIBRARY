-- Função para atualizar visibilidade dos comandos
local function filterCommands(searchText)
    local visibleCount = 0
    for _, cmdFrame in ipairs(cmdContainer:GetChildren()) do
        if cmdFrame:IsA("Frame") then
            local title = cmdFrame:FindFirstChild("Title")
            if title then
                if searchText == "" then
                    cmdFrame.Visible = true
                    cmdFrame.Position = UDim2.new(0, 2, 0, visibleCount * 54)
                    visibleCount = visibleCount + 1
                elseif string.find(string.lower(title.Text), string.lower(searchText), 1, true) then
                    cmdFrame.Visible = true
                    cmdFrame.Position = UDim2.new(0, 2, 0, visibleCount * 54)
                    visibleCount = visibleCount + 1
                else
                    cmdFrame.Visible = false
                end
            end
        end
    end
end

-- Configurar eventos da CommandBar
LMG2L["CommandBar_d"]:GetPropertyChangedSignal("Text"):Connect(function()
    filterCommands(LMG2L["CommandBar_d"].Text)
end)

LMG2L["CommandBar_d"].FocusLost:Connect(function(enterPressed)
    if enterPressed then
        local commandText = LMG2L["CommandBar_d"].Text
        if commandText ~= "" then
            -- Executar comando
            local cmdData = Commands[string.lower(commandText)]
            if cmdData and cmdData.callback then
                local success, result = pcall(cmdData.callback)
                if not success then
                    warn("Erro ao executar comando '" .. commandText .. "': " .. tostring(result))
                end
            end
            LMG2L["CommandBar_d"].Text = ""
        end
    end
end)

-- Função para registrar comandos via loadstring
function Library:RegisterCommand(name, description, callback)
    local cmdFrame = createCommandTemplate(name)
    cmdFrame:FindFirstChild("Title").Text = name
    cmdFrame:FindFirstChild("Description").Text = description
    cmdFrame.Visible = true
    cmdFrame.Parent = cmdContainer
    
    Commands[string.lower(name)] = {
        name = name,
        description = description,
        callback = callback
    }
    
    -- Reordenar todos os comandos
    filterCommands(LMG2L["CommandBar_d"].Text)
    
    return cmdFrame
end

-- Função para carregar comandos via loadstring
function Library:LoadCommands(code)
    local success, err = pcall(function()
        local func = loadstring(code)
        if func then
            func(self)
        end
    end)
    
    if not success then
        warn("Erro ao carregar comandos: " .. tostring(err))
    end
end


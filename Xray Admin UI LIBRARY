local isUsingScroll = false

-- Função para alternar entre Frame normal e ScrollingFrame baseada na quantidade (limite de 5 visíveis confortáveis)
local function checkScrollNeeded()
    local totalCommands = 0
    for _, child in ipairs(cmdContainer:GetChildren()) do
        if child:IsA("Frame") then totalCommands = totalCommands + 1 end
    end
    for _, child in ipairs(scrollFrame:GetChildren()) do
        if child:IsA("Frame") then totalCommands = totalCommands + 1 end
    end

    if totalCommands > 5 and not isUsingScroll then
        isUsingScroll = true
        for _, cmd in ipairs(cmdContainer:GetChildren()) do
            if cmd:IsA("Frame") then
                cmd.Parent = scrollFrame
            end
        end
        scrollFrame.CanvasSize = UDim2.new(0, 0, 0, totalCommands * 60)
        cmdContainer.Visible = false
        scrollFrame.Visible = true
    elseif totalCommands <= 5 and isUsingScroll then
        isUsingScroll = false
        for _, cmd in ipairs(scrollFrame:GetChildren()) do
            if cmd:IsA("Frame") then
                cmd.Parent = cmdContainer
            end
        end
        scrollFrame.CanvasSize = UDim2.new(0, 0, 0, 0)
        cmdContainer.Visible = true
        scrollFrame.Visible = false
    end
end

-- Filtragem de comandos com espaçamento vertical de 60px por item (52px altura + 8px gap)
local function filterCommands(searchText)
    local visibleCount = 0
    local currentContainer = isUsingScroll and scrollFrame or cmdContainer

    for _, cmdFrame in ipairs(currentContainer:GetChildren()) do
        if cmdFrame:IsA("Frame") then
            local title = cmdFrame:FindFirstChild("Title")
            local description = cmdFrame:FindFirstChild("Description")

            if title and description then
                local searchLower = string.lower(searchText)
                local titleLower = string.lower(title.Text)
                local descLower = string.lower(description.Text)

                local foundInTitle = string.find(titleLower, searchLower, 1, true)
                local foundInDesc = string.find(descLower, searchLower, 1, true)

                if searchText == "" or foundInTitle or foundInDesc then
                    cmdFrame.Visible = true
                    cmdFrame.Position = UDim2.new(0, 0, 0, visibleCount * 60)
                    visibleCount = visibleCount + 1
                else
                    cmdFrame.Visible = false
                end
            end
        end
    end

    if isUsingScroll then
        scrollFrame.CanvasSize = UDim2.new(0, 0, 0, visibleCount * 60)
    end
end

LMG2L["CommandBar_d"]:GetPropertyChangedSignal("Text"):Connect(function()
    filterCommands(LMG2L["CommandBar_d"].Text)
end)

LMG2L["CommandBar_d"].FocusLost:Connect(function(enterPressed)
    if enterPressed then
        local commandText = LMG2L["CommandBar_d"].Text
        if commandText ~= "" then
            local cmdData = Commands[string.lower(commandText)]
            if cmdData and cmdData.callback then
                local success, result = pcall(cmdData.callback)
                if not success then
                    warn("Erro ao executar comando '" .. commandText + "': " .. tostring(result))
                end
            end
            LMG2L["CommandBar_d"].Text = ""
        end
    end
end)

function Library:RegisterCommand(name, description, callback)
    local cmdFrame = createCommandTemplate(name)
    cmdFrame:FindFirstChild("Title").Text = name
    cmdFrame:FindFirstChild("Description").Text = description
    cmdFrame.Visible = true

    if isUsingScroll then
        cmdFrame.Parent = scrollFrame
    else
        cmdFrame.Parent = cmdContainer
    end

    Commands[string.lower(name)] = {
        name = name,
        description = description,
        callback = callback
    }

    checkScrollNeeded()
    filterCommands(LMG2L["CommandBar_d"].Text)

    return cmdFrame
end

function Library:LoadCommands(code)
    local success, err = pcall(function()
        local func = loadstring(code)
        if func then
            func(self)
        end
    end)

    if not success then
        warn("Erro ao carregar comandos: " .. tostring(err))
    end
end


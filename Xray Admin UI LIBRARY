-- Template para comandos
local function createCommandTemplate(name)
    local cmdFrame = Instance.new("Frame")
    cmdFrame.Name = name
    cmdFrame.Size = UDim2.new(1, 0, 0, 54)
    cmdFrame.BackgroundColor3 = Theme.SecondaryBg
    cmdFrame.BackgroundTransparency = 0.5
    cmdFrame.Visible = true
    
    local cmdCorner = Instance.new("UICorner")
    cmdCorner.CornerRadius = UDim.new(0, 6)
    cmdCorner.Parent = cmdFrame

    local title = Instance.new("TextLabel")
    title.Name = "Title"
    title.Size = UDim2.new(1, -20, 0, 24)
    title.Position = UDim2.new(0, 10, 0, 6)
    title.BackgroundTransparency = 1
    title.TextXAlignment = Enum.TextXAlignment.Left
    title.Font = Enum.Font.GothamMedium
    title.TextSize = 14
    title.TextColor3 = Theme.TextPrimary
    title.Text = ""
    title.Parent = cmdFrame
    
    local description = Instance.new("TextLabel")
    description.Name = "Description"
    description.Size = UDim2.new(1, -20, 0, 18)
    description.Position = UDim2.new(0, 10, 0, 30)
    description.BackgroundTransparency = 1
    description.TextXAlignment = Enum.TextXAlignment.Left
    description.Font = Enum.Font.Gotham
    description.TextSize = 12
    description.TextColor3 = Theme.TextSecondary
    description.Text = ""
    description.Parent = cmdFrame
    
    return cmdFrame
end

-- Filtro de Pesquisa Simplificado (Apenas esconde/mostra, o UIListLayout arruma a posição)
local function filterCommands(searchText)
    local searchLower = string.lower(searchText)
    
    for _, cmdFrame in ipairs(ScrollFrame:GetChildren()) do
        if cmdFrame:IsA("Frame") then
            local title = cmdFrame:FindFirstChild("Title")
            local description = cmdFrame:FindFirstChild("Description")
            
            if title and description then
                if searchText == "" then
                    cmdFrame.Visible = true
                else
                    local titleMatch = string.find(string.lower(title.Text), searchLower, 1, true)
                    local descMatch = string.find(string.lower(description.Text), searchLower, 1, true)
                    
                    cmdFrame.Visible = (titleMatch ~= nil or descMatch ~= nil)
                end
            end
        end
    end
end

CommandBar:GetPropertyChangedSignal("Text"):Connect(function()
    filterCommands(CommandBar.Text)
end)

CommandBar.FocusLost:Connect(function(enterPressed)
    if enterPressed then
        local commandText = CommandBar.Text
        if commandText ~= "" then
            local cmdData = Commands[string.lower(commandText)]
            if cmdData and cmdData.callback then
                local success, result = pcall(cmdData.callback)
                if not success then
                    warn("Erro ao executar comando '" .. commandText .. "': " .. tostring(result))
                end
            end
            CommandBar.Text = ""
        end
    end
end)

-- Registrar Comandos
function Library:RegisterCommand(name, description, callback)
    local cmdFrame = createCommandTemplate(name)
    cmdFrame.Title.Text = name
    cmdFrame.Description.Text = description
    cmdFrame.Parent = ScrollFrame
    
    Commands[string.lower(name)] = {
        name = name,
        description = description,
        callback = callback
    }
    
    filterCommands(CommandBar.Text)
    return cmdFrame
end

-- Carregar Scripts
function Library:LoadCommands(code)
    local success, err = pcall(function()
        local func = loadstring(code)
        if func then
            func(self)
        end
    end)
    
    if not success then
        warn("Erro ao carregar comandos: " .. tostring(err))
    end
end

-- Inicialização com Animações Suaves
local function init()
    local player = Players.LocalPlayer
    
    -- Configurar Thumbnail
    task.spawn(function()
        local success, image = pcall(function()
            return Players:GetUserThumbnailAsync(player.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size420x420)
        end)
        if success and image then
            Thumbnail.Image = image
        end
    end)
    
    -- Configurar Nome
    NameLabel.Text = "Welcome, " .. player.DisplayName
    
    -- Animação de Entrada
    local originalTopPos = Top.Position
    local originalMainPos = Main.Position
    
    Top.Position = UDim2.new(0, 0, -1, 0)
    Main.Position = UDim2.new(0, 0, 1, 50)
    Top.GroupTransparency = 1
    Main.GroupTransparency = 1
    
    local tweenInfo = TweenService:Create(Top, TweenInfo.new(0.6, Enum.EasingStyle.Cubic, Enum.EasingDirection.Out), {Position = originalTopPos, BackgroundTransparency = 0})
    TweenService:Create(Main, TweenInfo.new(0.6, Enum.EasingStyle.Cubic, Enum.EasingDirection.Out), {Position = originalMainPos, BackgroundTransparency = 0}):Play()
    tweenInfo:Play()
end

init()

Library.ScreenGui = XrayGui
Library.CommandBar = CommandBar

return Library

-- CONFIG SYSTEM - JSON + LOCAL FILES
-- =========================================================

local ConfigFolder = "FFh4xConfigs"

local function EnsureConfigFolder()
    if makefolder and isfolder then
        if not isfolder(ConfigFolder) then
            pcall(function() makefolder(ConfigFolder) end)
        end
    end
end
EnsureConfigFolder()

local function SerializeValue(value)
    local valueType = typeof(value)
    if valueType == "Color3" then
        return { __type = "Color3", R = value.R, G = value.G, B = value.B }
    elseif valueType == "EnumItem" then
        return { __type = "EnumItem", EnumType = tostring(value.EnumType), Name = value.Name }
    elseif valueType == "table" then
        local result = {}
        for k, v in pairs(value) do
            local serialized = SerializeValue(v)
            if serialized ~= nil then result[tostring(k)] = serialized end
        end
        return result
    elseif valueType == "string" or valueType == "number" or valueType == "boolean" then
        return value
    elseif value == nil then
        return nil
    end
    return nil
end

local function DeserializeValue(value)
    if type(value) ~= "table" then return value end
    if value.__type == "Color3" then
        return Color3.new(tonumber(value.R) or 1, tonumber(value.G) or 1, tonumber(value.B) or 1)
    elseif value.__type == "EnumItem" then
        local enumName = tostring(value.EnumType or ""):gsub("Enum%.", "")
        local enumObject = Enum[enumName]
        if enumObject then
            local success, enumItem = pcall(function() return enumObject[value.Name] end)
            if success then return enumItem end
        end
        return nil
    end
    local result = {}
    for k, v in pairs(value) do result[k] = DeserializeValue(v) end
    return result
end

local function EncodeConfig(data)
    local serialized = SerializeValue(data)
    local success, json = pcall(function() return HttpService:JSONEncode(serialized) end)
    return success and json or "{}"
end

local function DecodeConfig(json)
    local success, data = pcall(function() return HttpService:JSONDecode(json) end)
    if not success or type(data) ~= "table" then return nil end
    return DeserializeValue(data)
end

local function GetConfigPath(name)
    name = tostring(name or ""):gsub("[^%w_%-%s]", ""):gsub("^%s+", ""):gsub("%s+$", "")
    return name ~= "" and (ConfigFolder .. "/" .. name .. ".json") or nil
end

local function SaveLocalConfig(name, data)
    if not writefile then return false, "writefile não disponível" end
    EnsureConfigFolder()
    local path = GetConfigPath(name)
    if not path then return false, "Nome inválido" end
    local json = EncodeConfig(data)
    local success, err = pcall(function() writefile(path, json) end)
    return success, success and true or tostring(err)
end

local function LoadLocalConfig(name)
    if not readfile or not isfile then return nil end
    local path = GetConfigPath(name)
    if not path or not isfile(path) then return nil end
    local success, content = pcall(function() return readfile(path) end)
    return success and DecodeConfig(content) or nil
end

local function GetConfigNames()
    local result = {}
    if not listfiles then return result end
    EnsureConfigFolder()
    local success, files = pcall(function() return listfiles(ConfigFolder) end)
    if not success or type(files) ~= "table" then return result end
    for _, path in ipairs(files) do
        local filename = tostring(path):match("([^/\\]+)%.json$")
        if filename then table.insert(result, filename) end
    end
    table.sort(result)
    return result
end

local function DeleteLocalConfig(name)
    if not delfile then return false end
    local path = GetConfigPath(name)
    if not path or not isfile or not isfile(path) then return false end
    return pcall(function() delfile(path) end)
end

-- =========================================================
-- COMPONENT REGISTRY + APPLY CONFIG
-- =========================================================

function Library:RegisterComponent(flag, setter, getter)
    if not flag then return end
    Library.Components[flag] = { SetValue = setter, GetValue = getter }
end

function Library:SetFlag(flag, value, fireCallback)
    local component = Library.Components[flag]
    if component and component.SetValue then
        pcall(function() component.SetValue(value, fireCallback ~= false) end)
    else
        Library.Flags[flag] = value
    end
end

function Library:ApplyConfig(data)
    if type(data) ~= "table" then return false end
    
    -- Salva todos os valores
    for flag, value in pairs(data) do
        Library.Flags[flag] = value
    end
    
    -- Aplica nos componentes reais
    for flag, value in pairs(data) do
        local component = Library.Components[flag]
        if component and component.SetValue then
            pcall(function() component.SetValue(value, true) end)
        end
    end
    
    -- Tema
    if data.Config_Main then Library.Theme.Main = data.Config_Main end
    if data.Config_Section then Library.Theme.Section = data.Config_Section end
    if data.Config_Accent then Library.Theme.Accent = data.Config_Accent end
    if data.Config_SectionText then Library.Theme.SectionText = data.Config_SectionText end
    if data.Config_PrimaryText then Library.Theme.PrimaryText = data.Config_PrimaryText end
    if data.Config_SecondaryText then Library.Theme.SecondaryTextColor = data.Config_SecondaryText end
    
    Library:ApplyTheme()
    return true
end

function Library:ApplyTheme()
    local gui = Library.CurrentScreenGui
    if not gui then return end
    
    for _, object in ipairs(gui:GetDescendants()) do
        if object.Name == "Painel" then
            object.BackgroundColor3 = Library.Theme.Main
        end
        
        if object:GetAttribute("FFh4xMainBackground") then
            object.BackgroundColor3 = Library.Theme.Section
        end
        
        if object:IsA("TextLabel") or object:IsA("TextButton") or object:IsA("TextBox") then
            local role = object:GetAttribute("FFh4xTextRole")
            if role == "Section" then object.TextColor3 = Library.Theme.SectionText
            elseif role == "Primary" then object.TextColor3 = Library.Theme.PrimaryText
            elseif role == "Secondary" then object.TextColor3 = Library.Theme.SecondaryTextColor end
        end
        
        if object:GetAttribute("FFh4xAccent") then object.BackgroundColor3 = Library.Theme.Accent end
        if object:GetAttribute("FFh4xAccentText") then object.TextColor3 = Library.Theme.Accent end
    end
end

function ApplyThemeColors()
    Library:ApplyTheme()
end


function Library:SetTheme(newTheme)
    if type(newTheme) ~= "table" then return end
    for i, v in pairs(newTheme) do
        if Library.Theme[i] ~= nil then
            Library.Theme[i] = v
        end
    end
    ApplyThemeColors()
end

function Library:SaveConfig(name)
    if not name or tostring(name):gsub("%s", "") == "" then
        return false
    end
    return SaveCompleteConfig(name, BuildConfigData())
end

function Library:LoadConfig(name)
    local data = LoadCompleteConfig(name)
    if not data then
        return false
    end
    return ApplyCompleteConfig(data) == true
end

function Library:ExportConfigJSON()
    return EncodeCompleteConfig()
end

function Library:ImportConfigJSON(jsonString)
    if type(jsonString) ~= "string" or jsonString == "" then
        return false
    end
    local data = DecodeCompleteConfig(jsonString)
    if not data then
        return false
    end
    return ApplyCompleteConfig(data) == true
end

return Library

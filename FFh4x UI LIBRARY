            Library.Theme.SecondaryTextColor = color
            Library:ApplyTheme()
        end
    })
    
    -- MAIN 2 - CONFIGS
    ConfigTab:AddSection({Text = "Configurações", Side = "Main2"})
    
    local CurrentConfigName = ""
    
    ConfigTab:AddTextbox({
        Text = "Nome da Config",
        Placeholder = "Digite o nome...",
        Side = "Main2",
        Flag = "ConfigName",
        Callback = function(text) CurrentConfigName = text end
    })
    
    local ConfigDropdown
    local function RefreshConfigDropdown()
        local names = GetConfigNames()
        if ConfigDropdown and ConfigDropdown.SetList then ConfigDropdown:SetList(names) end
        return names
    end
    
    ConfigDropdown = ConfigTab:AddDropdown({
        Text = "Configs Salvas",
        List = GetConfigNames(),
        Default = nil,
        Side = "Main2",
        Flag = "SelectedConfig",
        Callback = function(name)
            if name then CurrentConfigName = tostring(name) end
        end
    })
    
    -- Função para pegar todos os dados incluindo tema
    local function GetConfigData()
        local data = {}
        for flag, value in pairs(Library.Flags) do data[flag] = value end
        data.Config_Main = Library.Theme.Main
        data.Config_Section = Library.Theme.Section
        data.Config_Accent = Library.Theme.Accent
        data.Config_SectionText = Library.Theme.SectionText
        data.Config_PrimaryText = Library.Theme.PrimaryText
        data.Config_SecondaryText = Library.Theme.SecondaryTextColor
        return data
    end
    
    ConfigTab:AddButton({
        Text = "Salvar Config",
        Side = "Main2",
        Callback = function()
            local name = tostring(CurrentConfigName or "")
            if name:gsub("%s", "") == "" then
                Window:Notify({Title = "Config", Content = "Digite um nome!", Duration = 3})
                return
            end
            
            local success, err = SaveLocalConfig(name, GetConfigData())
            if success then
                Window:Notify({Title = "Config", Content = "Config '" .. name .. "' salva!", Duration = 3})
                RefreshConfigDropdown()
            else
                Window:Notify({Title = "Erro", Content = tostring(err), Duration = 3})
            end
        end
    })
    
    ConfigTab:AddButton({
        Text = "Carregar Config",
        Side = "Main2",
        Callback = function()
            local name = tostring(CurrentConfigName or "")
            if name:gsub("%s", "") == "" then
                Window:Notify({Title = "Config", Content = "Selecione uma config!", Duration = 3})
                return
            end
            
            local data = LoadLocalConfig(name)
            if not data then
                Window:Notify({Title = "Config", Content = "Config não encontrada!", Duration = 3})
                return
            end
            
            Library:ApplyConfig(data)
            Window:Notify({Title = "Config", Content = "Config '" .. name .. "' carregada!", Duration = 3})
        end
    })
    
    ConfigTab:AddButton({
        Text = "Exportar JSON",
        Side = "Main2",
        Callback = function()
            local json = EncodeConfig(GetConfigData())
            if setclipboard then
                setclipboard(json)
                Window:Notify({Title = "JSON", Content = "JSON copiado!", Duration = 3})
            else
                Window:Notify({Title = "JSON", Content = json, Duration = 8})
            end
        end
    })
    
    ConfigTab:AddButton({
        Text = "Importar JSON",
        Side = "Main2",
        Callback = function()
            if not getclipboard then
                Window:Notify({Title = "Erro", Content = "Clipboard indisponível!", Duration = 3})
                return
            end
            local json = getclipboard()
            if not json or json == "" then
                Window:Notify({Title = "Erro", Content = "Clipboard vazio!", Duration = 3})
                return
            end
            local data = DecodeConfig(json)
            if not data then
                Window:Notify({Title = "Erro", Content = "JSON inválido!", Duration = 3})
                return
            end
            Library:ApplyConfig(data)
            Window:Notify({Title = "JSON", Content = "JSON importado!", Duration = 3})
        end
    })
    
    ConfigTab:AddButton({
        Text = "Excluir Config",
        Side = "Main2",
        Callback = function()
            local name = tostring(CurrentConfigName or "")
            if name:gsub("%s", "") == "" then
                Window:Notify({Title = "Config", Content = "Selecione uma config!", Duration = 3})
                return
            end
            if DeleteLocalConfig(name) then
                Window:Notify({Title = "Config", Content = "Config excluída!", Duration = 3})
                CurrentConfigName = ""
                RefreshConfigDropdown()
            else
                Window:Notify({Title = "Erro", Content = "Não foi possível excluir!", Duration = 3})
            end
        end
    })
    
    function Window:Notify(notifOptions)
        local Title = notifOptions.Title or "Notification"
        local Content = notifOptions.Content or ""
        local Duration = notifOptions.Duration or 5
        
        local NotifFrame = Instance.new("Frame")
        NotifFrame.Parent = ScreenGui
        NotifFrame.BackgroundColor3 = Library.Theme.Main
        NotifFrame.Position = UDim2.new(1, 10, 1, -100)
        NotifFrame.Size = UDim2.new(0, 250, 0, 80)
        local NCorner = Instance.new("UICorner"); NCorner.Parent = NotifFrame
        
        local NTitle = Instance.new("TextLabel")
        NTitle.Parent = NotifFrame
        NTitle.BackgroundTransparency = 1
        NTitle.Position = UDim2.new(0, 10, 0, 5)
        NTitle.Size = UDim2.new(1, -20, 0, 20)
        NTitle.Text = Title
        NTitle.TextColor3 = Library.Theme.Accent
        NTitle.TextSize = 15
        NTitle.FontFace = Font.new("rbxasset://fonts/families/Ubuntu.json", Enum.FontWeight.Bold)
        
        local NContent = Instance.new("TextLabel")
        NContent.Parent = NotifFrame
        NContent.BackgroundTransparency = 1
        NContent.Position = UDim2.new(0, 10, 0, 30)
        NContent.Size = UDim2.new(1, -20, 0, 40)
        NContent.Text = Content
        NContent.TextColor3 = Library.Theme.Text
        NContent.TextSize = 13
        NContent.TextWrapped = true
        NContent.FontFace = Font.new("rbxasset://fonts/families/Ubuntu.json")
        
        Library:Tween(NotifFrame, {Position = UDim2.new(1, -260, 1, -100)})
        task.delay(Duration, function()
            Library:Tween(NotifFrame, {Position = UDim2.new(1, 10, 1, -100)}, function()
                NotifFrame:Destroy()
            end)
        end)
    end
    
    return Window
end

-- =========================================================
-- FUNÇÕES GLOBAIS
-- =========================================================

function Library:SaveConfig(name)
    local data = {}
    for flag, value in pairs(Library.Flags) do data[flag] = value end
    data.Config_Main = Library.Theme.Main
    data.Config_Section = Library.Theme.Section
    data.Config_Accent = Library.Theme.Accent
    data.Config_SectionText = Library.Theme.SectionText
    data.Config_PrimaryText = Library.Theme.PrimaryText
    data.Config_SecondaryText = Library.Theme.SecondaryTextColor
    
    local json = EncodeConfig(data)
    if writefile then writefile(name .. ".json", json) end
end

function Library:LoadConfig(name)
    local data = LoadLocalConfig(name)
    if data then
        Library:ApplyConfig(data)
        return true
    end
    return false
end

function Library:SetTheme(newTheme)
    for i, v in pairs(newTheme) do
        if Library.Theme[i] then Library.Theme[i] = v end
    end
    Library:ApplyTheme()
end

function Library:ExportConfigJSON()
    return EncodeConfig(Library.Flags)
end

function Library:ImportConfigJSON(jsonString)
    local data = DecodeConfig(jsonString)
    if data then
        Library:ApplyConfig(data)
        return true
    end
    return false
end

return Library

    -- =========================================================
    
    local ConfigTab = Window:CreateTab({
        Name = "Config",
        Icon = "rbxassetid://114459453255031"
    })
    Library.ConfigTab = ConfigTab
    
    -- MAIN 1 - CORES
    ConfigTab:AddSection({Text = "Cores do Tema", Side = "Main1"})
    
    ConfigTab:AddColorPicker({
        Text = "Menu Background",
        Default = Library.Theme.Main,
        Side = "Main1",
        Flag = "Config_Main",
        Callback = function(color)
            Library.Theme.Main = color
            Library:ApplyTheme()
        end
    })
    
    ConfigTab:AddColorPicker({
        Text = "Mains Background",
        Default = Library.Theme.Section,
        Side = "Main1",
        Flag = "Config_Section",
        Callback = function(color)
            Library.Theme.Section = color
            Library:ApplyTheme()
        end
    })
    
    ConfigTab:AddColorPicker({
        Text = "Accent",
        Default = Library.Theme.Accent,
        Side = "Main1",
        Flag = "Config_Accent",
        Callback = function(color)
            Library.Theme.Accent = color
            Library:ApplyTheme()
        end
    })
    
    ConfigTab:AddColorPicker({
        Text = "Section Text",
        Default = Library.Theme.SectionText,
        Side = "Main1",
        Flag = "Config_SectionText",
        Callback = function(color)
            Library.Theme.SectionText = color
            Library:ApplyTheme()
        end

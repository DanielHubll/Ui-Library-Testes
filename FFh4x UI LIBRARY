    local H, S, V = Default:ToHSV()
    local Opened = false
    local LastColor = nil
    local LastUpdate = 0
    
    local function UpdateSatBrilhoBackground()
        SatBrilhoImg.BackgroundColor3 = Color3.fromHSV(H, 1, 1)
    end
    
    local function UpdateColor()
        local now = tick()
        if now - LastUpdate < 1/60 then return end
        LastUpdate = now
        local color = Color3.fromHSV(H, S, V)
        if color == LastColor then return end
        LastColor = color
        ColorDisplay.BackgroundColor3 = color
        UpdateSatBrilhoBackground()
        Library.Flags[Flag] = color
        task.spawn(function() Callback(color) end)
    end
    
    local function VisualUpdate(color, fromConfig)
        if typeof(color) ~= "Color3" then return end
        H, S, V = color:ToHSV()
        ColorDisplay.BackgroundColor3 = color
        UpdateSatBrilhoBackground()
        -- H na barra: posição Y = H (0 = topo, 1 = baixo)
        HCursor.Position = UDim2.new(0, 0, H, -1)
        -- S+B: X = Saturação, Y = 1 - Brilho (topo = brilho máximo)
        SBCursor.Position = UDim2.new(S, -3, 1 - V, -3)
        Library.Flags[Flag] = color
        LastColor = color
        
        if fromConfig then
            task.spawn(function()
                pcall(Callback, color)
            end)
        end
    end
    
    local function Toggle()
        if Library.IsDraggingWindow or Library.IsDraggingColorPicker then return end
        Opened = not Opened

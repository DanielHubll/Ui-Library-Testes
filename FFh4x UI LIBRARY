        table.sort(allButtons, function(a, b)
            -- Config sempre por último
            if a.Name == "Config" then
                return false
            end
            if b.Name == "Config" then
                return true
            end
            return a.LayoutOrder < b.LayoutOrder
        end)
        
        for index, button in ipairs(allButtons) do
            if button.Name == "Config" then
                button.LayoutOrder = 999999
            else
                button.LayoutOrder = index
            end
        end
    end
    

local function BuildConfigData()
    local data = {
        Version = 2,
        Flags = {},
        Theme = {},
        Tabs = {},
        Meta = {
            Logo = nil
        }
    }
    
    -- FLAGS
    for flag, value in pairs(Library.Flags) do
        data.Flags[flag] = SerializeValue(value)
    end
    
    -- THEME
    for name, color in pairs(Library.Theme) do
        if typeof(color) == "Color3" then
            data.Theme[name] = SerializeValue(color)
        end
    end
    
    -- LOGO
    local gui = Library.CurrentScreenGui
    if gui then
        local painel = gui:FindFirstChild("Painel")
        if painel then
            local right = painel:FindFirstChild("Right")
            if right then
                local logo = right:FindFirstChild("Logo")
                if logo and logo:IsA("ImageLabel") then
                    data.Meta.Logo = logo.Image
                end
            end
        end
    end
    
    -- TABS
    for _, tabData in ipairs(Library.TabDefinitions) do
        table.insert(data.Tabs, {
            Name = tabData.Name,
            Icon = tabData.Icon,
            LayoutOrder = tabData.LayoutOrder
        })
    end
    
    return data
end

local function DecodeCompleteConfig(json)
    local success, raw = pcall(function()
        return HttpService:JSONDecode(json)
    end)
    
    if not success or type(raw) ~= "table" then
        return nil
    end
    
    -- CONFIG NOVA (v2)
    if raw.Version then
        local result = {
            Version = raw.Version,
            Flags = {},
            Theme = {},
            Tabs = raw.Tabs or {},
            Meta = raw.Meta or {}
        }
        
        for flag, value in pairs(raw.Flags or {}) do
            result.Flags[flag] = DeserializeValue(value)
        end
        
        for name, value in pairs(raw.Theme or {}) do
            result.Theme[name] = DeserializeValue(value)
        end
        
        return result
    end
    
    -- COMPATIBILIDADE COM CONFIG ANTIGA (v1)
    local old = {}
    for flag, value in pairs(raw) do
        old[flag] = DeserializeValue(value)
    end
    
    return {
        Version = 1,
        Flags = old,
        Theme = {},
        Tabs = {},
        Meta = {}
    }
end

local function EncodeCompleteConfig()
    local data = BuildConfigData()
    local success, json = pcall(function()
        return HttpService:JSONEncode(data)
    end)
    
    if success then
        return json
    end
    
    warn("FFh4x: erro ao gerar JSON:", json)
    return "{}"
end

-- =========================================================
-- NOVO APPLY COMPLETE CONFIG
-- =========================================================

local function ApplyCompleteConfig(data)
    if type(data) ~= "table" then
        return false
    end
    
    -- FLAGS
    local flags = data.Flags or {}
    for flag, value in pairs(flags) do
        Library.Flags[flag] = value
    end
    
    -- THEME
    local theme = data.Theme or {}
    for themeName, value in pairs(theme) do
        if Library.Theme[themeName] ~= nil and typeof(value) == "Color3" then
            Library.Theme[themeName] = value
        end
    end
    
    -- LOGO
    local gui = Library.CurrentScreenGui
    if gui and data.Meta then
        local logoId = data.Meta.Logo
        if logoId then
            local painel = gui:FindFirstChild("Painel")
            if painel then
                local right = painel:FindFirstChild("Right")
                if right then
                    local logo = right:FindFirstChild("Logo")
                    if logo and logo:IsA("ImageLabel") then
                        logo.Image = tostring(logoId)
                    end
                end
            end
        end
    end
    
    -- COMPONENTES
    for _, component in ipairs(Library.Components.Toggles) do
        local value = Library.Flags[component.Flag]
        if value ~= nil and component.UpdateFn then
            pcall(component.UpdateFn, value, true)
        end
    end
    
    for _, component in ipairs(Library.Components.Sliders) do
        local value = Library.Flags[component.Flag]
        if value ~= nil and component.UpdateFn then
            pcall(component.UpdateFn, value, true)
        end
    end
    
    for _, component in ipairs(Library.Components.Dropdowns) do
        local value = Library.Flags[component.Flag]
        if value ~= nil and component.UpdateFn then
            pcall(component.UpdateFn, value, true)
        end
    end
    
    for _, component in ipairs(Library.Components.Keybinds) do
        local value = Library.Flags[component.Flag]
        if value ~= nil and component.UpdateFn then
            pcall(component.UpdateFn, value, true)
        end
    end
    
    for _, component in ipairs(Library.Components.ColorPickers) do
        local value = Library.Flags[component.Flag]
        if typeof(value) == "Color3" and component.UpdateFn then
            pcall(component.UpdateFn, value, true)
        end
    end
    
    for _, component in ipairs(Library.Components.Textboxes) do
        local value = Library.Flags[component.Flag]
        if value ~= nil and component.UpdateFn then
            pcall(component.UpdateFn, value, true)
        end
    end
    
    for _, component in ipairs(Library.Components.BodyParts) do
        local value = Library.Flags[component.Flag]
        if value ~= nil and component.UpdateFn then
            pcall(component.UpdateFn, value, true)
        end
    end
    
    for _, component in ipairs(Library.Components.MultiColorPickers) do
        local value = Library.Flags[component.Flag]
        if type(value) == "table" and component.UpdateFn then
            pcall(component.UpdateFn, value, true)
        end
    end
    
    -- CORES
    ApplyThemeColors()
    
    -- LAYOUT
    for _, tab in ipairs(Library.Tabs) do
        if tab.UpdateLayout then
            pcall(function()
                tab:UpdateLayout()
            end)
        end
    end
    
    return true
end

-- Compatibilidade com sistema antigo
local function ApplyLoadedConfig(data)
    if type(data) ~= "table" then
        return false
    end
    
    -- Converte formato antigo para novo
    local completeData = {
        Version = 1,
        Flags = data,
        Theme = {},
        Tabs = {},
        Meta = {}
    }
    
    return ApplyCompleteConfig(completeData)
end

-- =========================================================
-- SISTEMA DE ARQUIVOS LOCAIS (ATUALIZADO)
-- =========================================================

local function GetConfigPath(name)
    name = tostring(name or "")
    name = name:gsub("[^%w_%-%s]", "")
    name = name:gsub("^%s+", "")
    name = name:gsub("%s+$", "")
    
    if name == "" then
        return nil
    end
    
    return ConfigFolder .. "/" .. name .. ".json"
end

local function SaveCompleteConfig(name, data)
    if not writefile then
        return false, "writefile não disponível"
    end
    
    EnsureConfigFolder()
    
    local path = GetConfigPath(name)
    if not path then
        return false, "Nome inválido"
    end
    
    local json = EncodeCompleteConfig()
    local success, err = pcall(function()
        writefile(path, json)
    end)
    
    if not success then
        return false, tostring(err)
    end
    
    return true
end

local function LoadCompleteConfig(name)
    if not readfile or not isfile then
        return nil
    end
    
    local path = GetConfigPath(name)
    if not path or not isfile(path) then
        return nil
    end
    
    local success, content = pcall(function()
        return readfile(path)
    end)
    
    if not success then
        return nil
    end
    
    return DecodeCompleteConfig(content)
end

local function GetConfigNames()
    local result = {}
    
    if not listfiles then
        return result
    end
    
    EnsureConfigFolder()
    
    local success, files = pcall(function()
        return listfiles(ConfigFolder)
    end)
    
    if not success or type(files) ~= "table" then
        return result
    end
    
    for _, path in ipairs(files) do
        local filename = tostring(path):match("([^/\\]+)%.json$")
        if filename then
            table.insert(result, filename)
        end
    end
    
    table.sort(result)
    return result
end

local function DeleteLocalConfig(name)
    if not delfile then
        return false
    end
    
    local path = GetConfigPath(name)
    if not path or not isfile or not isfile(path) then
        return false
    end
    
    return pcall(function()
        delfile(path)
    end)
end


            local function Update(input)
                if Library.IsDraggingWindow then return end
                
                local now = tick()
                if now - LastUpdate < 1/60 then return end
                LastUpdate = now
                
                local pos = math.clamp((input.Position.X - SliderMain.AbsolutePosition.X) / SliderMain.AbsoluteSize.X, 0, 1)
                local val = math.floor(Min + (Max - Min) * pos)
                
                if val == LastValue then return end
                LastValue = val
                
                Info.Text = tostring(val) .. Suffix
                SliderBar.Size = UDim2.new(pos, 0, 1, 0)
                Cursor.Position = UDim2.new(pos, -9, 0, -7)
                Library.Flags[Flag] = val
                
                task.spawn(function()
                    Callback(val)
                end)
            end
            
            local function VisualUpdate(val, fromConfig)
                val = tonumber(val)
                if not val then return end
                val = math.clamp(val, Min, Max)
                
                local pos = 0
                if Max ~= Min then
                    pos = (val - Min) / (Max - Min)
                end
                
                Info.Text = tostring(val) .. Suffix
                SliderBar.Size = UDim2.new(pos, 0, 1, 0)
                Cursor.Position = UDim2.new(pos, -9, 0, -7)
                
                LastValue = val
                Library.Flags[Flag] = val
                
                if fromConfig then
                    task.spawn(function()
                        pcall(Callback, val)
                    end)
                end
            end
            
            SliderMain.InputBegan:Connect(function(input)
                if Library.IsDraggingWindow then return end
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    dragging = true
                    Library.IsDraggingSlider = true
                    SetAllScrollingEnabledFast(false)
                    Update(input)
                end
            end)
            
            UserInputService.InputEnded:Connect(function(input)
                if (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) and dragging then
                    dragging = false
                    Library.IsDraggingSlider = false
                    SetAllScrollingEnabledFast(true)
                end
            end)
            
            RegisterInputConnection(function(input)
                if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                    Update(input)
                end
            end)
            
            Library.Flags[Flag] = Default
            table.insert(Library.Components.Sliders, { Flag = Flag, UpdateFn = VisualUpdate })
        end
        

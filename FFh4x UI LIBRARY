        function Tab:GetMain(sideName)
            sideName = sideName or "Main1"
            
            if not self.Mains[sideName] then
                local main = Instance.new("ScrollingFrame")
                main.Name = sideName
                main.Parent = self.ContentFrame
                main.BackgroundColor3 = Library.Theme.MainBackground
                main.BorderSizePixel = 0
                main.Size = UDim2.new(0, 204, 0, 350)
                main.ScrollBarThickness = 0
                main.ElasticBehavior = Enum.ElasticBehavior.Never
                main.CanvasSize = UDim2.new(0, 0, 0, 0)
                main.ScrollingEnabled = true
                main.ScrollBarImageTransparency = 1
                RegisterScrollingFrame(main)
                
                local corner = Instance.new("UICorner")
                corner.Parent = main
                
                local layout = Instance.new("UIListLayout")
                layout.Parent = main
                layout.SortOrder = Enum.SortOrder.LayoutOrder
                layout.Padding = UDim.new(0, 8)
                layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
                
                local padding = Instance.new("UIPadding")
                padding.Parent = main
                padding.PaddingTop = UDim.new(0, 10)
                padding.PaddingBottom = UDim.new(0, 10)
                
                layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
                    local contentHeight = layout.AbsoluteContentSize.Y + 20
                    main.CanvasSize = UDim2.new(0, 0, 0, contentHeight)
                    local newHeight = math.min(contentHeight, 350)
                    if main.Size.Y.Offset ~= newHeight then
                        main.Size = UDim2.new(0, 204, 0, newHeight)
                        self:UpdateLayout()
                    end
                end)
                
                self.Mains[sideName] = main
                self:UpdateLayout()
            end
            
            if self.Mains[sideName].Visible == false then
                self.Mains[sideName].Visible = true
                self.Mains[sideName].Size = UDim2.new(0, 204, 0, 350)
                self:UpdateLayout()
            end
            
            return self.Mains[sideName]
        end
        
        function Tab:UpdateLayout()
            local sorted = {}
            for name, main in pairs(self.Mains) do
                if main.Visible then
                    local idx = tonumber(name:match("Main(%d+)")) or 999
                    table.insert(sorted, {Name = name, Main = main, Index = idx})
                end
            end
            table.sort(sorted, function(a, b) return a.Index < b.Index end)
            
            local colWidth, colGap, rowGap, startY = 204, 12, 10, 10
            local rowHeights = {}
            for i, data in ipairs(sorted) do
                local row = math.floor((i - 1) / 2)
                rowHeights[row] = math.max(rowHeights[row] or 0, data.Main.Size.Y.Offset)
            end
            
            for i, data in ipairs(sorted) do
                local col = (i - 1) % 2
                local row = math.floor((i - 1) / 2)
                local yPos = startY
                for r = 0, row - 1 do yPos = yPos + (rowHeights[r] or 350) + rowGap end
                data.Main.Position = UDim2.new(0, 2 + col * (colWidth + colGap), 0, yPos)
            end
            
            local maxRow = -1
            for r, _ in pairs(rowHeights) do maxRow = math.max(maxRow, r) end
            local totalHeight = startY
            if maxRow >= 0 then
                for r = 0, maxRow do totalHeight = totalHeight + (rowHeights[r] or 350) + rowGap end
                totalHeight = totalHeight - rowGap + startY
            end
            self.ContentFrame.CanvasSize = UDim2.new(0, 0, 0, math.max(totalHeight, self.ContentFrame.AbsoluteSize.Y))
        end
        

local function SetTextRole(object, role)
    if object and (object:IsA("TextLabel") or object:IsA("TextButton") or object:IsA("TextBox")) then
        object:SetAttribute("FFh4xTextRole", role)
    end
end

local function ApplyAccentColor()
    local gui = Library.CurrentScreenGui
    if not gui then return end
    
    for _, object in ipairs(gui:GetDescendants()) do
        if object:GetAttribute("FFh4xAccent") then
            if object:IsA("Frame") or object:IsA("TextButton") or object:IsA("ImageButton") then
                object.BackgroundColor3 = Library.Theme.Accent
            end
        end
        if object:GetAttribute("FFh4xAccentText") then
            if object:IsA("TextLabel") or object:IsA("TextButton") or object:IsA("TextBox") then
                object.TextColor3 = Library.Theme.Accent
            end
        end
    end
end

local function ApplyThemeColors()
    local gui = Library.CurrentScreenGui
    if not gui then return end
    
    -- Atualiza o fundo do menu (Painel)
    local painel = gui:FindFirstChild("Painel")
    if painel then
        painel.BackgroundColor3 = Library.Theme.MenuBackground
    end
    
    -- Atualiza texto de todos os elementos
    for _, object in ipairs(gui:GetDescendants()) do
        if object:IsA("TextLabel") or object:IsA("TextButton") or object:IsA("TextBox") then
            local role = object:GetAttribute("FFh4xTextRole")
            if role == "Section" then
                object.TextColor3 = Library.Theme.SectionText
            elseif role == "Primary" then
                object.TextColor3 = Library.Theme.PrimaryText
            elseif role == "Secondary" then
                object.TextColor3 = Library.Theme.SecondaryTextColor
            end
        end
    end
    
    -- Atualiza o fundo dos mains
    for _, tabData in pairs(Library.Tabs) do
        if tabData.Mains then
            for _, main in pairs(tabData.Mains) do
                if main then
                    main.BackgroundColor3 = Library.Theme.MainBackground
                end
            end
        end
    end
    
    -- Aplica cores de Accent
    ApplyAccentColor()
end


local ConfigFolder = "FFh4xConfigs"

local function EnsureConfigFolder()
    if makefolder and isfolder then
        if not isfolder(ConfigFolder) then
            pcall(function()
                makefolder(ConfigFolder)
            end)
        end
    end
end

EnsureConfigFolder()

local function SerializeValue(value)
    local valueType = typeof(value)
    
    if valueType == "Color3" then
        return {
            __type = "Color3",
            R = value.R,
            G = value.G,
            B = value.B
        }
    elseif valueType == "EnumItem" then
        return {
            __type = "EnumItem",
            EnumType = tostring(value.EnumType),
            Name = value.Name
        }
    elseif valueType == "table" then
        local result = {}
        for k, v in pairs(value) do
            local serialized = SerializeValue(v)
            if serialized ~= nil then
                result[tostring(k)] = serialized
            end
        end
        return result
    elseif valueType == "string" or valueType == "number" or valueType == "boolean" then
        return value
    elseif value == nil then
        return nil
    end
    return nil
end

local function DeserializeValue(value)
    if type(value) ~= "table" then
        return value
    end
    
    if value.__type == "Color3" then
        return Color3.new(
            tonumber(value.R) or 1,
            tonumber(value.G) or 1,
            tonumber(value.B) or 1
        )
    elseif value.__type == "EnumItem" then
        local enumName = tostring(value.EnumType or ""):gsub("Enum%.", "")
        local enumObject = Enum[enumName]
        if enumObject then
            local success, enumItem = pcall(function()
                return enumObject[value.Name]
            end)
            if success then
                return enumItem
            end
        end
        return nil
    end
    
    local result = {}
    for k, v in pairs(value) do
        result[k] = DeserializeValue(v)
    end
    return result
end

-- =========================================================
-- NOVO SISTEMA DE CONFIG COMPLETA

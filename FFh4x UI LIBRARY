local function SetTextRole(object, role)
    if object and (object:IsA("TextLabel") or object:IsA("TextButton") or object:IsA("TextBox")) then
        object:SetAttribute("FFh4xTextRole", role)
    end
end

local InputChangedConnections = {}
local function RegisterInputConnection(handler)
    local conn = UserInputService.InputChanged:Connect(handler)
    table.insert(InputChangedConnections, conn)
    return conn
end

local function SetAllScrollingEnabledFast(enabled)
    for _, scroll in ipairs(Library.ScrollFrames) do
        if scroll and scroll.Parent then scroll.ScrollingEnabled = enabled end
    end
end

local function RegisterScrollingFrame(scroll)
    table.insert(Library.ScrollFrames, scroll)
end

local function CloseAllDropdowns()
    for _, dropdownData in ipairs(Library.OpenDropdowns) do
        if dropdownData and dropdownData.Opened then
            dropdownData.Opened = false
            if dropdownData.Frame and dropdownData.Frame.Parent then
                Library:Tween(dropdownData.Frame, {Size = dropdownData.ClosedSize})
            end
            if dropdownData.Arrow and dropdownData.Arrow.Parent then
                Library:Tween(dropdownData.Arrow, {Rotation = 0})
            end
        end
    end
    Library.OpenDropdowns = {}
end

local function RegisterOpenDropdown(dropdownData)
    for i = #Library.OpenDropdowns, 1, -1 do
        local other = Library.OpenDropdowns[i]
        if other ~= dropdownData and other.Opened then
            other.Opened = false
            if other.Frame and other.Frame.Parent then
                Library:Tween(other.Frame, {Size = other.ClosedSize})
            end
            if other.Arrow and other.Arrow.Parent then
                Library:Tween(other.Arrow, {Rotation = 0})
            end
            table.remove(Library.OpenDropdowns, i)
        end
    end
    local exists = false
    for _, d in ipairs(Library.OpenDropdowns) do
        if d == dropdownData then exists = true; break end
    end
    if not exists then table.insert(Library.OpenDropdowns, dropdownData) end
end

local function MakeDraggable(dragObject, mainObject)
    local dragging, dragInput, dragStart, startPos = nil, nil, nil, nil
    local function update(input)
        if Library.IsDraggingSlider or Library.IsDraggingColorPicker then return end
        local delta = input.Position - dragStart
        mainObject.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
    dragObject.InputBegan:Connect(function(input)
        if Library.IsDraggingSlider or Library.IsDraggingColorPicker then return end
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            Library.IsDraggingWindow = true
            dragStart = input.Position
            startPos = mainObject.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                    Library.IsDraggingWindow = false
                end
            end)
        end
    end)
    dragObject.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)
    RegisterInputConnection(function(input)
        if input == dragInput and dragging then update(input) end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
            dragging = false
            Library.IsDraggingWindow = false
        end
    end)
end

function Library:Tween(object, goal, callback)
    local tween = TweenService:Create(object, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), goal)
    tween.Completed:Connect(callback or function() end)
    tween:Play()
end


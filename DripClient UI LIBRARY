        DropBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        DropBtn.TextSize = 16
        DropBtn.TextXAlignment = Enum.TextXAlignment.Left
        DropBtn.FontFace = Font.new("rbxasset://fonts/families/HighwayGothic.json")
        DropBtn.Parent = DropFrame
        
        local Icon = Instance.new("TextLabel")
        Icon.Size = UDim2.new(0, 32, 0, 32)
        Icon.Position = UDim2.new(1, -32, 0, 0)
        Icon.BackgroundTransparency = 1
        Icon.Text = "+"
        Icon.TextColor3 = Color3.fromRGB(172, 51, 255)
        Icon.TextSize = 20
        Icon.Parent = DropBtn
        
        local ListContainer = Instance.new("Frame")
        ListContainer.Size = UDim2.new(1, -16, 1, -40)
        ListContainer.Position = UDim2.new(0, 8, 0, 36)
        ListContainer.BackgroundTransparency = 1
        ListContainer.Parent = DropFrame
        
        local ListLayout = Instance.new("UIListLayout", ListContainer)
        ListLayout.SortOrder = Enum.SortOrder.LayoutOrder
        ListLayout.Padding = UDim.new(0, 4)
        
        local function UpdateSize()
            if isDropped then
                local contentHeight = ListLayout.AbsoluteContentSize.Y
                TweenService:Create(DropFrame, TweenInfo.new(0.2), {Size = UDim2.new(0, 512, 0, 40 + contentHeight)}):Play()
                Icon.Text = "-"
            else
                TweenService:Create(DropFrame, TweenInfo.new(0.2), {Size = UDim2.new(0, 512, 0, 32)}):Play()
                Icon.Text = "+"
            end
        end
        
        DropBtn.MouseButton1Click:Connect(function()
            isDropped = not isDropped
            UpdateSize()
        end)
        
        for _, item in ipairs(list) do
            local ItemBtn = Instance.new("TextButton")
            ItemBtn.Size = UDim2.new(1, 0, 0, 26)
            ItemBtn.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
            ItemBtn.Text = item
            ItemBtn.TextColor3 = Color3.fromRGB(200, 200, 200)
            ItemBtn.TextSize = 14
            ItemBtn.FontFace = Font.new("rbxasset://fonts/families/HighwayGothic.json")
            ItemBtn.Parent = ListContainer
            
            Instance.new("UICorner", ItemBtn).CornerRadius = UDim.new(0, 5)
            
            ItemBtn.MouseButton1Click:Connect(function()
                isDropped = false
                DropBtn.Text = "  " .. text .. " - [ " .. item .. " ]"
                UpdateSize()
                callback(item)
            end)
        end
        
        return dropdown
    end


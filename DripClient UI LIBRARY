        local OptionsFrame = Instance.new("ScrollingFrame")
        OptionsFrame.Name = "OptionsFrame"
        OptionsFrame.Size = UDim2.new(1, 0, 0, math.min(#options * 25, 150)) -- Max height 150, each option 25

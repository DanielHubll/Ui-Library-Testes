                TweenService:Create(OptionButton, TweenInfo.new(0.1), { BackgroundColor3 = Color3.fromRGB(60, 60, 60) }):Play()
            end)
            OptionButton.MouseLeave:Connect(function()
                TweenService:Create(OptionButton, TweenInfo.new(0.1), { BackgroundColor3 = Color3.fromRGB(30, 30, 30) }):Play()
            end)

            OptionButton.MouseButton1Click:Connect(function()
                DropdownButton.Text = optionText
                OptionsFrame.Visible = false
                callback(optionText)
            end)
        end

        DropdownButton.MouseButton1Click:Connect(function()
            OptionsFrame.Visible = not OptionsFrame.Visible
        end)

        dropdown.Instance = DropdownFrame

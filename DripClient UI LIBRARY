        OptionsFrame.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
        OptionsFrame.BorderSizePixel = 0
        OptionsFrame.Visible = false
        OptionsFrame.ZIndex = 2 -- Ensure it's above other elements
        OptionsFrame.Parent = DropdownFrame
        OptionsFrame.ScrollBarThickness = 6
        OptionsFrame.ScrollingDirection = Enum.ScrollingDirection.Y
        OptionsFrame.CanvasSize = UDim2.new(0,0,0, #options * 25)

        Instance.new("UICorner", OptionsFrame).CornerRadius = UDim.new(0, 5)
        local OptionsStroke = Instance.new("UIStroke", OptionsFrame)
        OptionsStroke.Transparency = 0.7
        OptionsStroke.Color = Color3.fromRGB(255, 255, 255)

        local OptionsLayout = Instance.new("UIListLayout", OptionsFrame)
        OptionsLayout.FillDirection = Enum.FillDirection.Vertical
        OptionsLayout.Padding = UDim.new(0, 2)

        for i, optionText in ipairs(options) do
            local OptionButton = Instance.new("TextButton")
